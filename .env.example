# AgentPROV local environment — copy to .env and fill in. NEVER commit .env.
# .env is read ONLY by the live-run CLI entry (`agentprov run ...`, needs the `live` extra) and only
# the variables a backend's allowlist names are passed to the isolated backend worker.
# Recommendation: use dedicated, spend-capped provider keys for live runs.

# --- AgentPROV -----------------------------------------------------------------
# Where corpora, the raw store, backend environments and live staging live. Keep it OUTSIDE the repo.
AGENTPROV_HOME=~/.agentprov
# Local copy of the frozen AgentDojo-PROV baseline corpora (for full-corpus migration gates only).
AGENTPROV_BASELINE_CORPUS=

# --- Model providers (live runs only) -------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=

# OpenAI-compatible local server (e.g. Ollama / vLLM)
LOCAL_LLM_BASE_URL=
LOCAL_MODEL_ID=
OMLX_API_KEY=
OMLX_MODEL=

# --- AutoDojo backend (live runs only) -------------------------------------------
# Path to an AutoDojo optimised-injection cache (variant_generation/variants/.../injections.json)
AUTODOJO_CACHE=
AUTODOJO_VARIANT=0
