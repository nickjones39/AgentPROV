@prefix apv:     <https://w3id.org/agentprov/ns#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

#################################################################
# AgentPROV vocabulary (apv) 0.2.0
#
# Terms of the AgentPROV PROV profile agentprov-prov/0.1 (docs/architecture/EF_provenance.md, E.4).
# Classes, properties and closed individual lists only; instances never live in this namespace.
# PROV-O terms are referenced, not imported. The Flowcept / PROV-AGENT ontology is not imported either:
# apv:ModelInvocation and apv:ToolExecution are aligned with PROV-AGENT AIModelInvocation and AgentTool in
# their rdfs:comment text only.
#
# Source of truth: src/agentprov/vocab/apv-0.2.ttl. docs/ns/apv-0.2.ttl is a byte copy (tools/sync_ns.py)
# and src/agentprov/prov/vocab.py holds the term constants (tools/gen_vocab_py.py).
#
# 0.2.0 (minor, additive; EF E.4.6 item 2) adds the recorded-null status properties apv:<property>Status (D-500)
# and apv:adapterAssumption (D-501). No 0.1.0 term changes type, range or meaning or is removed; the published
# 0.1.0 file stays at docs/ns/apv-0.1.ttl.
#################################################################

<https://w3id.org/agentprov/ns>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/agentprov/ns/0.2.0> ;
    owl:versionInfo "0.2.0" ;
    owl:priorVersion <https://w3id.org/agentprov/ns/0.1.0> ;
    owl:backwardCompatibleWith <https://w3id.org/agentprov/ns/0.1.0> ;
    rdfs:label "AgentPROV vocabulary"@en ;
    dcterms:title "AgentPROV vocabulary (apv)"@en ;
    rdfs:comment "Terms for evidence-qualified W3C PROV bundles of LLM-agent executions: evidence classes, epistemic statuses, assumptions, message and activity classes, and assessment terms."@en ;
    dcterms:creator <https://github.com/nickjones39> ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:modified "2026-10-23"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "apv" ;
    vann:preferredNamespaceUri "https://w3id.org/agentprov/ns#" ;
    skos:note "The namespace is registered at w3id.org (perma-id/w3id.org pull request 6836, merged 2026-10-09)."@en .


## Closed-list classes (enumeration types)

apv:EvidenceClass
    a owl:Class ;
    rdfs:label "Evidence class"@en ;
    rdfs:comment "Evidence class of a node, statement or attribute (AER ev values O, D and I)."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:AttestingParty
    a owl:Class ;
    rdfs:label "Attesting party"@en ;
    rdfs:comment "Party that recorded an OBSERVED fact (AER by value or the party of an evf value O:party)."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:EpistemicStatus
    a owl:Class ;
    rdfs:label "Epistemic status"@en ;
    rdfs:comment "Why a property value is absent: the seven AER unk reasons plus RecordedNull and NotObservable."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Assumption
    a owl:Class ;
    rdfs:label "Assumption"@en ;
    rdfs:comment "A core assumption an adapter rule may declare. Adapter-declared terms with the same verification shape are also admitted; they are not individuals of this class and are stated as strings on apv:adapterAssumption (apv 0.2.0)."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:SentTransform
    a owl:Class ;
    rdfs:label "Sent transform"@en ;
    rdfs:comment "A transform applied to a message when the request was built (a defence is never a sent transform)."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:CallStatus
    a owl:Class ;
    rdfs:label "Call status"@en ;
    rdfs:comment "Status of a model call."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ExecutionStatus
    a owl:Class ;
    rdfs:label "Execution status"@en ;
    rdfs:comment "Status of a tool execution."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:DispatchStatus
    a owl:Class ;
    rdfs:label "Dispatch status"@en ;
    rdfs:comment "Why a tool-call request was never dispatched."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:OutcomeOrigin
    a owl:Class ;
    rdfs:label "Outcome origin"@en ;
    rdfs:comment "Origin of a judgement value."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:DerivationType
    a owl:Class ;
    rdfs:label "Derivation type"@en ;
    rdfs:comment "Type of a derivation made by a defence or by injection placement."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Verdict
    a owl:Class ;
    rdfs:label "Verdict"@en ;
    rdfs:comment "Verdict of a decision."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:IntegrityValue
    a owl:Class ;
    rdfs:label "Integrity value"@en ;
    rdfs:comment "Three-valued integrity label, fail-closed."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:SecurityRole
    a owl:Class ;
    rdfs:label "Security role"@en ;
    rdfs:comment "Security role of a tool call or execution (multi-valued)."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:MarkerStatus
    a owl:Class ;
    rdfs:label "Marker status"@en ;
    rdfs:comment "Status of an injection marker when it differs from present; only Ambiguous is a stated status."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:AssessmentClaim
    a owl:Class ;
    rdfs:label "Assessment claim"@en ;
    rdfs:comment "Claim of an assessment entity."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ProfileStatus
    a owl:Class ;
    rdfs:label "Profile status"@en ;
    rdfs:comment "Status of a profile or projection."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Capability
    a owl:Class ;
    rdfs:label "Capability"@en ;
    rdfs:comment "A capability individual of a capture profile."@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .


## Classes

apv:ModelInvocation
    a owl:Class ;
    rdfs:label "Model invocation"@en ;
    rdfs:comment "A model call: one request to a model service. Status kept, discarded or error (a cached call is a CacheRead). Aligned in meaning with PROV-AGENT AIModelInvocation."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:CacheRead
    a owl:Class ;
    rdfs:label "Cache read"@en ;
    rdfs:comment "A model call served from a cache without inference: no model use and no provider association."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ToolExecution
    a owl:Class ;
    rdfs:label "Tool execution"@en ;
    rdfs:comment "The execution of a tool by a tool runtime. Aligned in meaning with PROV-AGENT AgentTool."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Decision
    a owl:Class ;
    rdfs:label "Decision"@en ;
    rdfs:comment "A defence, approval or policy decision about a subject (allow, deny, modify, redact, escalate, terminate or other)."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Run
    a owl:Class ;
    rdfs:label "Run"@en ;
    rdfs:comment "The run scope of an execution."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Pass
    a owl:Class ;
    rdfs:label "Pass"@en ;
    rdfs:comment "One pass (attempt) of the agent pipeline within a run; a new pass starts from fresh messages."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:AgentInvocation
    a owl:Class ;
    rdfs:label "Agent invocation"@en ;
    rdfs:comment "An invocation of an agent within a run."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:SubagentInvocation
    a owl:Class ;
    rdfs:label "Subagent invocation"@en ;
    rdfs:comment "An invocation of a subagent, started by a spawning tool execution or model call."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Step
    a owl:Class ;
    rdfs:label "Step"@en ;
    rdfs:comment "A scope of kind other, with its kind kept in apv:subtype."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:CheckerRun
    a owl:Class ;
    rdfs:label "Checker run"@en ;
    rdfs:comment "A synthetic checker run that generated a judgement when the source records no generating activity."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:HarnessRuleEvaluation
    a owl:Class ;
    rdfs:label "Harness rule evaluation"@en ;
    rdfs:comment "The evaluation of a harness rule that generated a judgement from other judgements."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:GenericActivity
    a owl:Class ;
    rdfs:label "Generic activity"@en ;
    rdfs:comment "An activity of a generic kind (AER activity record); its kind is in apv:activityType."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:PolicyEvaluation
    a owl:Class ;
    rdfs:label "Policy evaluation"@en ;
    rdfs:comment "The activity that evaluates a taint or exposure policy and generates the assessments of an assessment bundle."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:CaptureSession
    a owl:Class ;
    rdfs:label "Capture session"@en ;
    rdfs:comment "A live capture session recorded by agentprov-capture."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Mapping
    a owl:Class ;
    rdfs:label "Mapping"@en ;
    rdfs:comment "The adapter mapping of raw artefacts to an AgentPROV Execution Record (AER)."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Annotation
    a owl:Class ;
    rdfs:label "Annotation"@en ;
    rdfs:comment "The semantic annotation of an AER, generating a SEM annotation set."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ProvDerivation
    a owl:Class ;
    rdfs:label "PROV derivation"@en ;
    rdfs:comment "The derivation of PROV bundles from an AER and its annotations."@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ExecutionDescription
    a owl:Class ;
    rdfs:label "Execution description"@en ;
    rdfs:comment "The description of an execution: mode, unit, benchmark, task, attack and defence identity."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Message
    a owl:Class ;
    rdfs:label "Message"@en ;
    rdfs:comment "A message of the conversation. A message with at least one tool-call request is additionally a prov:Collection."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:SystemMessage
    a owl:Class ;
    rdfs:label "System message"@en ;
    rdfs:comment "A message with the system role."@en ;
    rdfs:subClassOf apv:Message ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:UserMessage
    a owl:Class ;
    rdfs:label "User message"@en ;
    rdfs:comment "A message with the user role."@en ;
    rdfs:subClassOf apv:Message ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:AssistantMessage
    a owl:Class ;
    rdfs:label "Assistant message"@en ;
    rdfs:comment "A message with the assistant role."@en ;
    rdfs:subClassOf apv:Message ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ToolMessage
    a owl:Class ;
    rdfs:label "Tool message"@en ;
    rdfs:comment "A message with the tool role."@en ;
    rdfs:subClassOf apv:Message ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:DeveloperMessage
    a owl:Class ;
    rdfs:label "Developer message"@en ;
    rdfs:comment "A message with the developer role."@en ;
    rdfs:subClassOf apv:Message ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:OtherRoleMessage
    a owl:Class ;
    rdfs:label "Other role message"@en ;
    rdfs:comment "A message with any other role; the role string is kept in apv:messageRole."@en ;
    rdfs:subClassOf apv:Message ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:MessagePart
    a owl:Class ;
    rdfs:label "Message part"@en ;
    rdfs:comment "A part of a message."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:TextPart
    a owl:Class ;
    rdfs:label "Text part"@en ;
    rdfs:comment "A text part."@en ;
    rdfs:subClassOf apv:MessagePart ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ReasoningPart
    a owl:Class ;
    rdfs:label "Reasoning part"@en ;
    rdfs:comment "A reasoning part."@en ;
    rdfs:subClassOf apv:MessagePart ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ToolCallRequest
    a owl:Class ;
    rdfs:label "Tool call request"@en ;
    rdfs:comment "A tool-call request part (a tool_call part of an assistant message)."@en ;
    rdfs:subClassOf apv:MessagePart ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ToolResult
    a owl:Class ;
    rdfs:label "Tool result"@en ;
    rdfs:comment "A tool-result part."@en ;
    rdfs:subClassOf apv:MessagePart ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:BlobPart
    a owl:Class ;
    rdfs:label "Blob part"@en ;
    rdfs:comment "A part holding a blob."@en ;
    rdfs:subClassOf apv:MessagePart ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:FilePart
    a owl:Class ;
    rdfs:label "File part"@en ;
    rdfs:comment "A part holding a file reference."@en ;
    rdfs:subClassOf apv:MessagePart ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:UriPart
    a owl:Class ;
    rdfs:label "URI part"@en ;
    rdfs:comment "A part holding a URI."@en ;
    rdfs:subClassOf apv:MessagePart ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:RefusalPart
    a owl:Class ;
    rdfs:label "Refusal part"@en ;
    rdfs:comment "A refusal part."@en ;
    rdfs:subClassOf apv:MessagePart ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:OtherPart
    a owl:Class ;
    rdfs:label "Other part"@en ;
    rdfs:comment "A part of any other type; the type is kept in apv:subtype."@en ;
    rdfs:subClassOf apv:MessagePart ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Model
    a owl:Class ;
    rdfs:label "Model"@en ;
    rdfs:comment "A model identity: the requested or served model of an actor or a model call."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:State
    a owl:Class ;
    rdfs:label "State"@en ;
    rdfs:comment "A state of an environment, store or sandbox, identified by a digest; a state of another target carries apv:subtype."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:EnvironmentState
    a owl:Class ;
    rdfs:label "Environment state"@en ;
    rdfs:comment "A state of the task environment."@en ;
    rdfs:subClassOf apv:State ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:StoreState
    a owl:Class ;
    rdfs:label "Store state"@en ;
    rdfs:comment "A state of an agent store."@en ;
    rdfs:subClassOf apv:State ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:SandboxState
    a owl:Class ;
    rdfs:label "Sandbox state"@en ;
    rdfs:comment "A state of a sandbox."@en ;
    rdfs:subClassOf apv:State ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Fixture
    a owl:Class ;
    rdfs:label "Fixture"@en ;
    rdfs:comment "A fixture of an execution: configuration provenance recorded in the core bundle."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:InjectionPayload
    a owl:Class ;
    rdfs:label "Injection payload"@en ;
    rdfs:comment "An injection payload fixture."@en ;
    rdfs:subClassOf apv:Fixture ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:EnvironmentSeed
    a owl:Class ;
    rdfs:label "Environment seed"@en ;
    rdfs:comment "An environment seed fixture."@en ;
    rdfs:subClassOf apv:Fixture ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:AttackPlan
    a owl:Class ;
    rdfs:label "Attack plan"@en ;
    rdfs:comment "An attack plan fixture; also a prov:Plan."@en ;
    rdfs:subClassOf apv:Fixture, prov:Plan ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:TaskPrompt
    a owl:Class ;
    rdfs:label "Task prompt"@en ;
    rdfs:comment "A task prompt fixture."@en ;
    rdfs:subClassOf apv:Fixture ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:SystemPrompt
    a owl:Class ;
    rdfs:label "System prompt"@en ;
    rdfs:comment "A system prompt fixture."@en ;
    rdfs:subClassOf apv:Fixture ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ToolDefinitions
    a owl:Class ;
    rdfs:label "Tool definitions"@en ;
    rdfs:comment "A fixture holding the tool definitions available to a model call."@en ;
    rdfs:subClassOf apv:Fixture ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:GroundTruth
    a owl:Class ;
    rdfs:label "Ground truth"@en ;
    rdfs:comment "A ground-truth fixture."@en ;
    rdfs:subClassOf apv:Fixture ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Outcome
    a owl:Class ;
    rdfs:label "Outcome"@en ;
    rdfs:comment "The judgement of an execution (an AER judgement); it carries no polarity or meaning, which are SEM annotations."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:GenericArtefact
    a owl:Class ;
    rdfs:label "Generic artefact"@en ;
    rdfs:comment "An artefact of a generic kind (AER artefact record); its kind is in apv:artefactType."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ContextWindow
    a owl:Class ;
    rdfs:label "Context window"@en ;
    rdfs:comment "A model call's context as a collection of messages. Reserved for the deferred collection context encoding."@en ;
    rdfs:subClassOf prov:Dictionary ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Gap
    a owl:Class ;
    rdfs:label "Gap"@en ;
    rdfs:comment "A recorded gap: an unknown AER pointer that has no fixed status property."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:CaptureProfile
    a owl:Class ;
    rdfs:label "Capture profile"@en ;
    rdfs:comment "The capture profile of a source: what it provides, does not provide and cannot observe."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Assessment
    a owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "An assessment entity: a claim, label or policy result in an assessment bundle or inference bundle."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:RawSourceArtefact
    a owl:Class ;
    rdfs:label "Raw source artefact"@en ;
    rdfs:comment "A content-addressed raw source artefact."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ExecutionRecord
    a owl:Class ;
    rdfs:label "Execution record"@en ;
    rdfs:comment "An AgentPROV Execution Record (AER) of one execution."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:SemanticAnnotationSet
    a owl:Class ;
    rdfs:label "Semantic annotation set"@en ;
    rdfs:comment "A SEM annotation set."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ExecutionProvenance
    a owl:Class ;
    rdfs:label "Execution provenance"@en ;
    rdfs:comment "The version-independent provenance of an execution, of which each bundle is a specialisation."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:LegacyProjection
    a owl:Class ;
    rdfs:label "Legacy projection"@en ;
    rdfs:comment "A projection in a legacy profile, such as the released or regenerated adprov-v2.3-compat graph."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:RuleCatalogue
    a owl:Class ;
    rdfs:label "Rule catalogue"@en ;
    rdfs:comment "A rule catalogue, as a plan: the engine catalogue or an adapter catalogue."@en ;
    rdfs:subClassOf prov:Plan ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:SemanticsProfile
    a owl:Class ;
    rdfs:label "Semantics profile"@en ;
    rdfs:comment "A SEM semantics profile, as a plan."@en ;
    rdfs:subClassOf prov:Plan ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:CoreBundle
    a owl:Class ;
    rdfs:label "Core bundle"@en ;
    rdfs:comment "The core bundle: OBSERVED and DERIVED statements."@en ;
    rdfs:subClassOf prov:Bundle ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:InferenceBundle
    a owl:Class ;
    rdfs:label "Inference bundle"@en ;
    rdfs:comment "An inference bundle: INFERRED statements, keyed by method set."@en ;
    rdfs:subClassOf prov:Bundle ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:AssessmentBundle
    a owl:Class ;
    rdfs:label "Assessment bundle"@en ;
    rdfs:comment "An assessment bundle: labels, claims and policy results over the core, keyed by semantics profile."@en ;
    rdfs:subClassOf prov:Bundle ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:AgentSystem
    a owl:Class ;
    rdfs:label "Agent system"@en ;
    rdfs:comment "An LLM agent system (AER actor kind llm_agent); instances are also prov:SoftwareAgent."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ModelService
    a owl:Class ;
    rdfs:label "Model service"@en ;
    rdfs:comment "A model service that served an invocation; instances are also prov:SoftwareAgent."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ToolRuntime
    a owl:Class ;
    rdfs:label "Tool runtime"@en ;
    rdfs:comment "A tool runtime that executes tool calls; instances are also prov:SoftwareAgent."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:EnvironmentActor
    a owl:Class ;
    rdfs:label "Environment actor"@en ;
    rdfs:comment "An environment as an actor; instances are also prov:SoftwareAgent."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:User
    a owl:Class ;
    rdfs:label "User"@en ;
    rdfs:comment "A user (AER actor kind user); instances are also prov:Person."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:SimulatedUser
    a owl:Class ;
    rdfs:label "Simulated user"@en ;
    rdfs:comment "A simulated user; instances are also prov:SoftwareAgent."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Attacker
    a owl:Class ;
    rdfs:label "Attacker"@en ;
    rdfs:comment "An attacker; whether a person or an organisation is unknown, so there is no PROV subtype."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Judge
    a owl:Class ;
    rdfs:label "Judge"@en ;
    rdfs:comment "A judge; instances are also prov:SoftwareAgent."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Defence
    a owl:Class ;
    rdfs:label "Defence"@en ;
    rdfs:comment "A defence (AER actor kind defense); instances are also prov:SoftwareAgent."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Harness
    a owl:Class ;
    rdfs:label "Harness"@en ;
    rdfs:comment "A harness; instances are also prov:SoftwareAgent."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Benchmark
    a owl:Class ;
    rdfs:label "Benchmark"@en ;
    rdfs:comment "A benchmark acting as an actor; instances are also prov:SoftwareAgent."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Adapter
    a owl:Class ;
    rdfs:label "Adapter"@en ;
    rdfs:comment "An AgentPROV adapter software agent; instances are also prov:SoftwareAgent."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ProvEngine
    a owl:Class ;
    rdfs:label "PROV engine"@en ;
    rdfs:comment "The AgentPROV provenance engine software agent; instances are also prov:SoftwareAgent."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Planner
    a owl:Class ;
    rdfs:label "Planner"@en ;
    rdfs:comment "Role class added to an actor whose role is planner."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Generator
    a owl:Class ;
    rdfs:label "Generator"@en ;
    rdfs:comment "Role class added to an actor whose role is generator."@en ;
    rdfs:subClassOf prov:Agent ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .


## Properties

apv:evidenceClass
    a owl:ObjectProperty ;
    rdfs:label "Evidence class"@en ;
    rdfs:comment "Evidence class of a node, statement or attribute (exactly one per element)."@en ;
    rdfs:range apv:EvidenceClass ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:rule
    a owl:DatatypeProperty ;
    rdfs:label "Rule"@en ;
    rdfs:comment "Id of the engine rule that produced the element, without any pointer; an xsd:string equal to the rule id."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:basisRule
    a owl:DatatypeProperty ;
    rdfs:label "Basis rule"@en ;
    rdfs:comment "Id of an AER or SEM rule behind the premise records, without any pointer; an xsd:string."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:rulePointer
    a owl:DatatypeProperty ;
    rdfs:label "Rule pointer"@en ;
    rdfs:comment "Scoped rule reference (rule id#pointer) behind apv:basisRule, when a citation is scoped."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:sourcePointer
    a owl:DatatypeProperty ;
    rdfs:label "Source pointer"@en ;
    rdfs:comment "Source pointer of the form record id plus RFC 6901 pointer, for example mc2/input/3."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:attestedBy
    a owl:ObjectProperty ;
    rdfs:label "Attested by"@en ;
    rdfs:comment "Party that recorded an OBSERVED premise field."@en ;
    rdfs:range apv:AttestingParty ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:assumption
    a owl:ObjectProperty ;
    rdfs:label "Assumption"@en ;
    rdfs:comment "A core apv:Assumption individual cited by a rule. From apv 0.2.0 an adapter-declared term is stated on apv:adapterAssumption instead (EF E.10 item 11)."@en ;
    rdfs:range apv:Assumption ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:adapterAssumption
    a owl:DatatypeProperty ;
    rdfs:label "Adapter assumption"@en ;
    rdfs:comment "An adapter-declared assumption cited by a rule, written <ns>:<Name> (for example rope:GuardDeniesBeforeDispatch). A string, not an IRI, because documents declare no adapter prefixes (EF E.10 item 11, D-17). Used like apv:assumption on nodes and qualified relations (EF E.1.5 item 6). Added in apv 0.2.0."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:premise
    a owl:ObjectProperty ;
    rdfs:label "Premise"@en ;
    rdfs:comment "A premise statement of a communication or an assessment."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:viaEntity
    a owl:ObjectProperty ;
    rdfs:label "Via entity"@en ;
    rdfs:comment "An entity that witnesses a communication between two activities."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:method
    a owl:DatatypeProperty ;
    rdfs:label "Method"@en ;
    rdfs:comment "Id of the inference method (rule) of an INFERRED statement, or the marker rule and normaliser of a payload claim."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:confidence
    a owl:DatatypeProperty ;
    rdfs:label "Confidence"@en ;
    rdfs:comment "Confidence output of an inference method."@en ;
    rdfs:range xsd:double ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:threshold
    a owl:DatatypeProperty ;
    rdfs:label "Threshold"@en ;
    rdfs:comment "Threshold output of an inference method."@en ;
    rdfs:range xsd:double ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:derivedAttribute
    a owl:ObjectProperty ;
    rdfs:label "Derived attribute"@en ;
    rdfs:comment "Property of an attribute whose class is DERIVED on an OBSERVED element."@en ;
    rdfs:range rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:afterEvidenceClass
    a owl:ObjectProperty ;
    rdfs:label "After evidence class"@en ;
    rdfs:comment "Weakest evidence class among the after edges kept on a node."@en ;
    rdfs:range apv:EvidenceClass ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:startTimeStatus
    a owl:ObjectProperty ;
    rdfs:label "Start time status"@en ;
    rdfs:comment "Why the start time is absent."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:endTimeStatus
    a owl:ObjectProperty ;
    rdfs:label "End time status"@en ;
    rdfs:comment "Why the end time is absent."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:contextStatus
    a owl:ObjectProperty ;
    rdfs:label "Context status"@en ;
    rdfs:comment "Why the model input (context) is unknown."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:outputStatus
    a owl:ObjectProperty ;
    rdfs:label "Output status"@en ;
    rdfs:comment "Status of the output of a model call, for example Lost for a call known to have happened but not held."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:requestStatus
    a owl:ObjectProperty ;
    rdfs:label "Request status"@en ;
    rdfs:comment "Why the wire request is absent."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:responseStatus
    a owl:ObjectProperty ;
    rdfs:label "Response status"@en ;
    rdfs:comment "Why the wire response is absent."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:usageStatus
    a owl:ObjectProperty ;
    rdfs:label "Usage status"@en ;
    rdfs:comment "Why the usage is absent."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:paramsStatus
    a owl:ObjectProperty ;
    rdfs:label "Params status"@en ;
    rdfs:comment "Why the parameters are absent."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:finishReasonStatus
    a owl:ObjectProperty ;
    rdfs:label "Finish reason status"@en ;
    rdfs:comment "Why the finish reason is absent, or apv:RecordedNull when the source recorded it as null (EF E.5 item 5; apv 0.2.0)."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:requestedModelStatus
    a owl:ObjectProperty ;
    rdfs:label "Requested model status"@en ;
    rdfs:comment "Why the requested model is absent, or apv:RecordedNull when the source recorded it as null (EF E.5 item 5; apv 0.2.0)."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:servedModelStatus
    a owl:ObjectProperty ;
    rdfs:label "Served model status"@en ;
    rdfs:comment "Why the served model is absent, or apv:RecordedNull when the source recorded it as null (EF E.5 item 5; apv 0.2.0)."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:requestedArgsStatus
    a owl:ObjectProperty ;
    rdfs:label "Requested args status"@en ;
    rdfs:comment "Why the requested arguments of a tool execution are absent."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:effectiveArgsStatus
    a owl:ObjectProperty ;
    rdfs:label "Effective args status"@en ;
    rdfs:comment "Why the effective arguments of a tool execution are absent."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:contentStatus
    a owl:ObjectProperty ;
    rdfs:label "Content status"@en ;
    rdfs:comment "Why the content of a part or pre-decision entity is absent or null."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:providerCallIdStatus
    a owl:ObjectProperty ;
    rdfs:label "Provider call id status"@en ;
    rdfs:comment "Why the provider call id is absent, or apv:RecordedNull when the source recorded it as null (EF E.5 item 5; apv 0.2.0)."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:argsRawStatus
    a owl:ObjectProperty ;
    rdfs:label "Args raw status"@en ;
    rdfs:comment "Why the raw arguments are absent."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:indexStatus
    a owl:ObjectProperty ;
    rdfs:label "Index status"@en ;
    rdfs:comment "Why the index is absent, or apv:RecordedNull when the source recorded it as null (EF E.5 item 5; apv 0.2.0)."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:orderStatus
    a owl:ObjectProperty ;
    rdfs:label "Order status"@en ;
    rdfs:comment "Why the order (after edges) is absent."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:dispatchStatus
    a owl:ObjectProperty ;
    rdfs:label "Dispatch status"@en ;
    rdfs:comment "Whether a tool-call request was dispatched; set to Denied or NotDispatched on a request with no tool execution."@en ;
    rdfs:range apv:DispatchStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:scopeStatus
    a owl:DatatypeProperty ;
    rdfs:label "Scope status"@en ;
    rdfs:comment "How a scope ended, as recorded: ok, error, aborted or limit."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:activityStatus
    a owl:DatatypeProperty ;
    rdfs:label "Activity status"@en ;
    rdfs:comment "Status of a generic activity, as recorded by the source."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

# Recorded-null status properties (apv 0.2.0, D-500): an asserted JSON null on a data property is stated as
# <property>Status apv:RecordedNull and the data property is omitted (EF E.5 item 5).

apv:activityStatusStatus
    a owl:ObjectProperty ;
    rdfs:label "Activity status status"@en ;
    rdfs:comment "Status of apv:activityStatus on a node that carries no value for it: apv:RecordedNull when the source recorded null, and the data property is then omitted (EF E.5 item 5). Added in apv 0.2.0."@en ;
    rdfs:range apv:EpistemicStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:activityTypeStatus
