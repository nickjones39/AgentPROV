    rdfs:comment "Role of a raw artefact."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:provPrimary
    a owl:DatatypeProperty ;
    rdfs:label "Prov primary"@en ;
    rdfs:comment "Whether the artefact is a primary source of the execution: native, byte_derived, secondary or unknown (hadPrimarySource only for native and byte_derived)."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:originKind
    a owl:DatatypeProperty ;
    rdfs:label "Origin kind"@en ;
    rdfs:comment "Kind of the origin of a raw artefact."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:originRepository
    a owl:DatatypeProperty ;
    rdfs:label "Origin repository"@en ;
    rdfs:comment "Repository of an origin: the git or hub repository, the Zenodo DOI or the corpus name."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:originRevision
    a owl:DatatypeProperty ;
    rdfs:label "Origin revision"@en ;
    rdfs:comment "Revision of an origin: the git commit, hub revision or corpus version."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:originPath
    a owl:DatatypeProperty ;
    rdfs:label "Origin path"@en ;
    rdfs:comment "Path of an origin: the path in the repository or corpus, the Zenodo file name or the URL."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:originBlob
    a owl:DatatypeProperty ;
    rdfs:label "Origin blob"@en ;
    rdfs:comment "Git blob SHA-1 of a git origin."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:originContainer
    a owl:DatatypeProperty ;
    rdfs:label "Origin container"@en ;
    rdfs:comment "Container of an archive-member origin."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:originLabel
    a owl:DatatypeProperty ;
    rdfs:label "Origin label"@en ;
    rdfs:comment "Label of an archive-member origin."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:aerVersion
    a owl:DatatypeProperty ;
    rdfs:label "Aer version"@en ;
    rdfs:comment "Version of the AER specification, for example aer/0.1."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:semVersion
    a owl:DatatypeProperty ;
    rdfs:label "Sem version"@en ;
    rdfs:comment "Version of the SEM specification."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:sourceKey
    a owl:DatatypeProperty ;
    rdfs:label "Source key"@en ;
    rdfs:comment "Source key of an execution: sha256:hex# followed by the JCS of its location."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:accounting
    a owl:DatatypeProperty ;
    rdfs:label "Accounting"@en ;
    rdfs:comment "Accounting of the AER seal, carried on the AER entity."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:issue
    a owl:DatatypeProperty ;
    rdfs:label "Issue"@en ;
    rdfs:comment "Issue code of the AER seal."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:catalogueId
    a owl:DatatypeProperty ;
    rdfs:label "Catalogue id"@en ;
    rdfs:comment "Id of a rule catalogue."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:softwareName
    a owl:DatatypeProperty ;
    rdfs:label "Software name"@en ;
    rdfs:comment "Name of a software agent."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:softwareVersion
    a owl:DatatypeProperty ;
    rdfs:label "Software version"@en ;
    rdfs:comment "Version of a software agent."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:derivationKey
    a owl:DatatypeProperty ;
    rdfs:label "Derivation key"@en ;
    rdfs:comment "Derivation key of a bundle."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:contextEncoding
    a owl:DatatypeProperty ;
    rdfs:label "Context encoding"@en ;
    rdfs:comment "Context encoding used by a derivation."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:profileOptions
    a owl:DatatypeProperty ;
    rdfs:label "Profile options"@en ;
    rdfs:comment "Profile options of a derivation as a JCS string."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:vocabularyVersion
    a owl:DatatypeProperty ;
    rdfs:label "Vocabulary version"@en ;
    rdfs:comment "Version of this ontology used by a derivation."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:profile
    a owl:DatatypeProperty ;
    rdfs:label "Profile"@en ;
    rdfs:comment "Profile of a bundle or projection, for example adprov-v2.3-compat."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:flattenedFrom
    a owl:ObjectProperty ;
    rdfs:label "Flattened from"@en ;
    rdfs:comment "The core bundle a flattened core was built from (flattened core is deferred)."@en ;
    rdfs:range prov:Bundle ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:corpusVersion
    a owl:DatatypeProperty ;
    rdfs:label "Corpus version"@en ;
    rdfs:comment "Corpus version in which a bundle was released."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:provides
    a owl:ObjectProperty ;
    rdfs:label "Provides"@en ;
    rdfs:comment "A capability the source provides."@en ;
    rdfs:range apv:Capability ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:notProvided
    a owl:ObjectProperty ;
    rdfs:label "Not provided"@en ;
    rdfs:comment "A capability the source does not provide."@en ;
    rdfs:range apv:Capability ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:notObservable
    a owl:ObjectProperty ;
    rdfs:label "Not observable"@en ;
    rdfs:comment "A capability that cannot be observed in principle."@en ;
    rdfs:range apv:Capability ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:subject
    a owl:ObjectProperty ;
    rdfs:label "Subject"@en ;
    rdfs:comment "The subject of an assessment: a node, or a statement IRI."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:object
    a owl:ObjectProperty ;
    rdfs:label "Object"@en ;
    rdfs:comment "The object of an assessment, for example a context member or a payload fixture."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:claim
    a owl:ObjectProperty ;
    rdfs:label "Claim"@en ;
    rdfs:comment "The claim of an assessment."@en ;
    rdfs:range apv:AssessmentClaim ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:policy
    a owl:DatatypeProperty ;
    rdfs:label "Policy"@en ;
    rdfs:comment "Id and version of the policy behind an assessment."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:integrity
    a owl:ObjectProperty ;
    rdfs:label "Integrity"@en ;
    rdfs:comment "Integrity label, on assessment mentions."@en ;
    rdfs:range apv:IntegrityValue ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:securityRole
    a owl:ObjectProperty ;
    rdfs:label "Security role"@en ;
    rdfs:comment "Security role of a tool call or execution (multi-valued), on assessment mentions."@en ;
    rdfs:range apv:SecurityRole ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:sourceChannel
    a owl:DatatypeProperty ;
    rdfs:label "Source channel"@en ;
    rdfs:comment "Channel through which untrusted content arrived, on assessment mentions."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:declaredSender
    a owl:DatatypeProperty ;
    rdfs:label "Declared sender"@en ;
    rdfs:comment "Sender declared in the content (a parse fact), on assessment mentions."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:annotationType
    a owl:DatatypeProperty ;
    rdfs:label "Annotation type"@en ;
    rdfs:comment "Namespaced type of a SEM annotation outside the closed list."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:annotationValue
    a owl:DatatypeProperty ;
    rdfs:label "Annotation value"@en ;
    rdfs:comment "Value of a SEM annotation outside the closed list, as a JCS string."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:markerStatus
    a owl:ObjectProperty ;
    rdfs:label "Marker status"@en ;
    rdfs:comment "Status of an injection marker claim, for example Ambiguous."@en ;
    rdfs:range apv:MarkerStatus ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:spanStart
    a owl:DatatypeProperty ;
    rdfs:label "Span start"@en ;
    rdfs:comment "Start offset in Unicode scalar values into the text of the part."@en ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:spanEnd
    a owl:DatatypeProperty ;
    rdfs:label "Span end"@en ;
    rdfs:comment "End offset (half-open) in Unicode scalar values into the text of the part."@en ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:matchedArg
    a owl:DatatypeProperty ;
    rdfs:label "Matched arg"@en ;
    rdfs:comment "RFC 6901 pointer into the arguments of a call that matched."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:authorName
    a owl:DatatypeProperty ;
    rdfs:label "Author name"@en ;
    rdfs:comment "Author name parsed from content."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:annotationId
    a owl:DatatypeProperty ;
    rdfs:label "Annotation id"@en ;
    rdfs:comment "Id of the SEM annotation behind a mention."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .


## Individuals (closed lists, per ontology version)

apv:Observed
    a owl:NamedIndividual, apv:EvidenceClass ;
    rdfs:label "Observed"@en ;
    rdfs:comment "Recorded first-hand by a stated party (AER ev O)."@en ;
    skos:notation "O" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Derived
    a owl:NamedIndividual, apv:EvidenceClass ;
    rdfs:label "Derived"@en ;
    rdfs:comment "Follows deterministically from recorded facts and a verified assumption or constraint (AER ev D)."@en ;
    skos:notation "D" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Inferred
    a owl:NamedIndividual, apv:EvidenceClass ;
    rdfs:label "Inferred"@en ;
    rdfs:comment "Rests on a heuristic, policy, model or unverified assumption (AER ev I); never in the core bundle."@en ;
    skos:notation "I" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ByCapture
    a owl:NamedIndividual, apv:AttestingParty ;
    rdfs:label "By capture"@en ;
    rdfs:comment "Recorded by AgentPROV live capture (hash-chained capture/0.1 log, wire blobs, environment digests)."@en ;
    skos:notation "capture" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:BySource
    a owl:NamedIndividual, apv:AttestingParty ;
    rdfs:label "By source"@en ;
    rdfs:comment "Recorded by the original harness's own log."@en ;
    skos:notation "source" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ByProvider
    a owl:NamedIndividual, apv:AttestingParty ;
    rdfs:label "By provider"@en ;
    rdfs:comment "Self-reported by the model API (served model, usage, finish reason)."@en ;
    skos:notation "provider" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ByBenchmark
    a owl:NamedIndividual, apv:AttestingParty ;
    rdfs:label "By benchmark"@en ;
    rdfs:comment "Recorded by the benchmark: checker verdicts and benchmark-supplied ground truth such as injection payloads."@en ;
    skos:notation "benchmark" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ByConfig
    a owl:NamedIndividual, apv:AttestingParty ;
    rdfs:label "By config"@en ;
    rdfs:comment "Taken from the harness input configuration; configured is not effective."@en ;
    skos:notation "config" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ByReplay
    a owl:NamedIndividual, apv:AttestingParty ;
    rdfs:label "By replay"@en ;
    rdfs:comment "Recorded by a re-execution of recorded calls, an observation of the replay."@en ;
    skos:notation "replay" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:NotRecorded
    a owl:NamedIndividual, apv:EpistemicStatus ;
    rdfs:label "Not recorded"@en ;
    rdfs:comment "The source format or instrumentation has no slot for it."@en ;
    skos:notation "not_recorded" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Lost
    a owl:NamedIndividual, apv:EpistemicStatus ;
    rdfs:label "Lost"@en ;
    rdfs:comment "The source had it but discarded it."@en ;
    skos:notation "lost" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Overwritten
    a owl:NamedIndividual, apv:EpistemicStatus ;
    rdfs:label "Overwritten"@en ;
    rdfs:comment "Captured only after an in-place transformation destroyed the original."@en ;
    skos:notation "overwritten" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Withheld
    a owl:NamedIndividual, apv:EpistemicStatus ;
    rdfs:label "Withheld"@en ;
    rdfs:comment "Deliberately not exposed (provider-hidden reasoning; secrets redacted by capture)."@en ;
    skos:notation "withheld" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:Ambiguous
    a owl:NamedIndividual, apv:EpistemicStatus, apv:MarkerStatus ;
    rdfs:label "Ambiguous"@en ;
    rdfs:comment "A value is present but unusable; also used as a marker status."@en ;
    skos:notation "ambiguous" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:NotCaptured
    a owl:NamedIndividual, apv:EpistemicStatus ;
    rdfs:label "Not captured"@en ;
    rdfs:comment "Live capture failed to record something it should have, or the context held content the record does not."@en ;
    skos:notation "not_captured" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:NotApplicable
    a owl:NamedIndividual, apv:EpistemicStatus ;
    rdfs:label "Not applicable"@en ;
    rdfs:comment "The property cannot exist for this record."@en ;
    skos:notation "not_applicable" ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:RecordedNull
    a owl:NamedIndividual, apv:EpistemicStatus ;
    rdfs:label "Recorded null"@en ;
    rdfs:comment "The source positively recorded null or empty, which keeps null distinct from an empty string."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:NotObservable
    a owl:NamedIndividual, apv:EpistemicStatus ;
    rdfs:label "Not observable"@en ;
    rdfs:comment "Not observable by black-box capture in principle; only estimates are possible (capture profile only)."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:FullContextResend
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Full context resend"@en ;
    rdfs:comment "Every model call of an actor sends the whole current message list of its pass, in order, with no pruning, summarising or re-insertion."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:OneCallPerAssistantMessage
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "One call per assistant message"@en ;
    rdfs:comment "Each assistant message of an actor is the output of exactly one model call of that actor."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:AutoExecution
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Auto execution"@en ;
    rdfs:comment "Every dispatched tool call is dispatched by the runtime without confirmation, on behalf of the requester."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:SequentialToolExecution
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Sequential tool execution"@en ;
    rdfs:comment "The calls of one request execute in request order on a shared environment."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:FreshMessagesPerPass
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Fresh messages per pass"@en ;
    rdfs:comment "A new pass starts from fresh messages; the environment carries over."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:RerunOnEmptyReply
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Rerun on empty reply"@en ;
    rdfs:comment "A pass whose final message content is null (an empty string or list does not count) triggers another pass."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:LastPassOnlyLogging
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Last pass only logging"@en ;
    rdfs:comment "A log holds only the message list of the final pass of its cell."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:CheckerUsesOutput
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Checker uses output"@en ;
    rdfs:comment "The task's checker reads the final model output text."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:CheckerUsesPreState
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Checker uses pre state"@en ;
    rdfs:comment "The task's checker reads the pre-environment (deep copy taken before the first pass)."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:CheckerUsesPostState
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Checker uses post state"@en ;
    rdfs:comment "The task's checker reads the post-environment."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:CheckerUsesCallTrace
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Checker uses call trace"@en ;
    rdfs:comment "The task's checker reads the tool calls of the scored attempt only."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:AgentActsForUser
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Agent acts for user"@en ;
    rdfs:comment "The agent system acts on behalf of the (simulated) user."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ScriptedUser
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Scripted user"@en ;
    rdfs:comment "User turns are produced by the benchmark, not by a person."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:InjectionPlacement
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Injection placement"@en ;
    rdfs:comment "The benchmark places each registered payload at its vector in the initial environment."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:SingleModelPerActor
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Single model per actor"@en ;
    rdfs:comment "All model calls of an actor are served by the actor's configured model."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:EnvironmentCarriedOver
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Environment carried over"@en ;
    rdfs:comment "The harness carries the same environment object into the next pass; verified per harness."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:EnvironmentDigestCanonical
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Environment digest canonical"@en ;
    rdfs:comment "Environment digests are over a canonical serialisation of the whole state, so equal digests mean equal states."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:InstrumentationUntruncated
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Instrumentation untruncated"@en ;
    rdfs:comment "An instrumentation that records model input neither filters nor truncates it."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ReplayFaithful
    a owl:NamedIndividual, apv:Assumption ;
    rdfs:label "Replay faithful"@en ;
    rdfs:comment "Replaying recorded calls in a fresh environment reproduces the original environment's behaviour; assessment-only, never core."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ContextMessage
    a owl:NamedIndividual, prov:Role ;
    rdfs:label "Context message"@en ;
    rdfs:comment "Role of a message used as model input by a model invocation."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ModelInput
    a owl:NamedIndividual, prov:Role ;
    rdfs:label "Model input"@en ;
    rdfs:comment "Role of the model entity used by a model invocation."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ToolDefinitionsInput
    a owl:NamedIndividual, prov:Role ;
    rdfs:label "Tool definitions input"@en ;
    rdfs:comment "Role of the tool-definitions fixture used by a model invocation."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:CallRequestInput
    a owl:NamedIndividual, prov:Role ;
    rdfs:label "Call request input"@en ;
    rdfs:comment "Role of the request part used by a tool execution."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:AgentSystemRole
    a owl:NamedIndividual, prov:Role ;
    rdfs:label "Agent system role"@en ;
    rdfs:comment "Role of the agent system associated with a model invocation."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:InferenceProvider
    a owl:NamedIndividual, prov:Role ;
    rdfs:label "Inference provider"@en ;
    rdfs:comment "Role of the model service associated with a model invocation."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:ExecutingRuntime
    a owl:NamedIndividual, prov:Role ;
    rdfs:label "Executing runtime"@en ;
    rdfs:comment "Role of the tool runtime associated with a tool execution."@en ;
    rdfs:isDefinedBy <https://w3id.org/agentprov/ns> .

apv:DefenceRole
    a owl:NamedIndividual, prov:Role ;
    rdfs:label "Defence role"@en ;
