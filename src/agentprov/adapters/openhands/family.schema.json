{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/agentprov/schema/adapters/openhands/family-0.1.json",
  "title": "[family.openhands] table of an openhands source profile (D.4.1, D.17.11; closed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "verified_code", "fixed_replies", "not_executed_notices", "control_calls", "semantics_profile"],
  "properties": {
    "source": {"enum": ["oas", "redcode"], "description": "which path grammar the profile's runs follow (D.17.1)"},
    "verified_code": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commit"],
        "properties": {
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "applies": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
          "note": {"type": "string"}
        }
      },
      "description": "commits whose OpenHands code produced the runs (D-24, D-172)"
    },
    "harness_version": {"type": "string", "minLength": 1, "description": "the OpenHands version known only from a lock file (class I)"},
    "fake_user_model": {"type": "string", "minLength": 1, "description": "the model the harness code at the pin names for its simulated user (class I)"},
    "fixed_replies": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "description": "SHA-256 of fixed simulated-user reply texts"},
    "not_executed_notices": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "the controller's not-executed notice texts, verbatim"},
    "control_calls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "tool names kept as control calls (finish)"},
    "semantics_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}}
    },
    "redact": {
      "description": "Redaction of third-party workstation account segments in tool and environment output (D-604, D-606; the D-476 grammar): rules {id, scope, pattern, replacement, leaf?, note?}, checked further by agentprov.adapters.openhands.redact.parse_redact_rules",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "pattern", "replacement"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "scope": {"type": "string", "enum": ["tool_output"]},
          "pattern": {"type": "string"},
          "replacement": {"type": "string"},
          "leaf": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "quirk": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "observed"],
        "properties": {
          "id": {"type": "string", "pattern": "^openhands\\.[a-z][a-z0-9_]*$"},
          "rules": {"type": "array", "items": {"type": "string", "pattern": "^openhands\\.[a-z][a-z0-9_.]*@[1-9][0-9]*$"}},
          "note": {"type": "string"},
          "observed": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
        }
      }
    }
  }
}
