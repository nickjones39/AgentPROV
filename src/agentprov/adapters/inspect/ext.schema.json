{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/agentprov/schema/adapters/inspect/ext-0.1.json",
  "title": "ext.inspect of AER records written by the inspect.eval mapper (C.10; D.9.2; closed member list)",
  "description": "Verbatim Inspect fields without a core slot. Values are source data (attachment references resolved) and are open JSON; the member names are closed. Not a published corpus schema in v0.1 (AD-10 row 13).",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "event"],
      "properties": {"index": {"type": "integer", "minimum": 0}, "event": {"type": "object"}}
    }
  },
  "properties": {
    "run_id": {"description": "execution: eval.run_id"},
    "eval_id": {"description": "execution: eval.eval_id"},
    "task_args": {"description": "execution: eval.task_args"},
    "epoch": {"description": "execution: sample epoch"},
    "uuid": {"description": "execution: sample uuid; model_call/tool_execution: event uuid"},
    "target": {"description": "execution: sample target; judgement: score event target"},
    "sample_metadata": {"description": "execution: sample metadata other than the profile's ground-truth keys"},
    "revision": {"description": "bench actor: eval.revision verbatim (its commit is abbreviated)"},
    "task_version": {"description": "bench actor: eval.task_version"},
    "working_time": {"description": "run scope / model_call / tool_execution: working time (s)"},
    "working_start": {"description": "model_call / tool_execution: working_start (not monotonic, D.9.3)"},
    "model_usage": {"description": "run scope: sample.model_usage"},
    "role_usage": {"description": "run scope: sample.role_usage"},
    "turn_count": {"description": "run scope: sample.turn_count"},
    "error_retries": {"description": "run scope: sample.error_retries"},
    "limit": {"description": "run scope: the sample_limit event's type, limit and message"},
    "sample_limit": {"description": "run scope: sample.limit"},
    "error": {"description": "run scope: sample.error; model_call: error text; tool_execution/decision/message: ToolCallError"},
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type"],
      "properties": {"id": {"type": "string"}, "name": {}, "type": {}},
      "description": "scope: the Inspect span"
    },
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"},
               "description": "scope: events kept verbatim (inspect.event_kept_in_ext@1); tool_execution: ToolEvent.events"},
    "compaction": {"$ref": "#/$defs/event", "description": "model_call or scope: the compaction event (inspect.compaction@1)"},
    "call": {"type": "object", "description": "model_call: ModelCall time, call_key and call_refs"},
    "retries": {"description": "model_call: ModelEvent.retries"},
    "cache": {"description": "model_call: ModelEvent.cache other than 'read'"},
    "model_role": {"description": "model_call: ModelEvent.role"},
    "requested_model": {"description": "model_call: ModelEvent.requested_model"},
    "tool_choice": {"description": "model_call: ModelEvent.tool_choice"},
    "usage_extra": {"type": "object", "description": "model_call: usage members without an AER Usage slot"},
    "failed": {"description": "tool_execution: ToolEvent.failed"},
    "agent": {"description": "tool_execution: ToolEvent.agent"},
    "truncated": {"description": "tool_execution: ToolEvent.truncated (from, to)"},
    "id": {"description": "message: the Inspect message id"},
    "source": {"description": "message: ChatMessage.source"},
    "model": {"description": "message: ChatMessageAssistant.model"},
    "metadata": {"description": "message: ChatMessage.metadata; judgement: Score.metadata"},
    "function": {"description": "message: ChatMessageTool.function"},
    "tool_call_id": {"description": "message: ChatMessageTool.tool_call_id"},
    "part_extra": {"type": "object", "description": "message: per part index, content-item members without a part slot"},
    "redacted": {"type": "array", "description": "any record: D-182, the redacted pointers and the profile rule of each, [{p, rule: <profile id>@<version>#<rule id>}]; never the original"},
    "approver": {"description": "decision: ApprovalEvent.approver"},
    "reviewer": {"description": "decision: ReviewEvent.reviewer"},
    "modified": {"description": "decision: ApprovalEvent.modified (the replacement call)"},
    "message": {"description": "decision: ApprovalEvent/ReviewEvent.message"},
    "decision": {"description": "decision: the approver's verbatim decision"},
    "cmd": {"description": "activity: SandboxEvent.cmd"},
    "file": {"description": "activity: SandboxEvent.file"},
    "options": {"description": "activity: SandboxEvent.options"},
    "input": {"description": "activity: SandboxEvent.input"},
    "result": {"description": "activity: SandboxEvent.result (exit code)"},
    "explanation": {"description": "judgement: Score.explanation"},
    "answer": {"description": "judgement: Score.answer"},
    "history": {"description": "judgement: Score.history"},
    "intermediate": {"description": "judgement: ScoreEvent.intermediate"},
    "scorer_args": {"description": "judgement: ScoreEvent.scorer_args"},
    "provenance": {"description": "judgement: ScoreEdit.provenance"}
  }
}
