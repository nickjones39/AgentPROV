{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/agentprov/schema/adapters/agentdojo/ext-0.1.json",
  "title": "ext.agentdojo of agentdojo.tracelogger AER records (docs/architecture D.6.5-D.6.6, D.6.11, D.6.12; closed)",
  "description": "Closed schema of the ext.agentdojo member written by the TraceLogger mapper, one definition per record kind. Values copied from a source may be C.11.3 reserved objects ($utf16, $int, $lit), so copied values are typed loosely. Not a published corpus schema (AD-10 row 13); the tests check every emitted ext.agentdojo against it. Quirk hooks write under their own namespaces (ext.<ns>), never here.",
  "$defs": {
    "copied": {"description": "a value copied from the source (any JSON, possibly a C.11.3 reserved object)"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "pipeline_name": {"$ref": "#/$defs/copied"},
        "error": {"$ref": "#/$defs/copied"},
        "cell_benchmark": {"description": "the live cell's benchmark as recorded, where the profile's suites map gives another (regeneration-batch item 27 (a))", "$ref": "#/$defs/copied"},
        "task_kind": {"enum": ["injection_task_as_user_task", "dos"]},
        "extra": {"type": "object"},
        "committed_no_later_than": {
          "description": "D.6.16, class D: RFC 3339 UTC committer date of the commit that introduced the log's blob; an upper bound on the run time, never a PROV time",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "benchmark_era": {
          "description": "D.6.16, class I: the candidate benchmark version of a file that records none (agentdojo.benchmark_era_from_commit@1)",
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate", "basis"],
          "properties": {
            "candidate": {"type": "string", "pattern": "^v[0-9]+(\\.[0-9]+){0,2}$"},
            "basis": {"enum": ["registered", "pre_versioning"]},
            "next": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "cut_date"],
              "properties": {
                "version": {"type": "string", "pattern": "^v[0-9]+(\\.[0-9]+){0,2}$"},
                "cut_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
              }
            }
          }
        },
        "id_style_provider": {"type": "string"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version_label_semantics": {"enum": ["label_not_suite_version", "cli_default_not_suite_version"]}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre_state_not_initial": {"const": true}
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_call_id": {"$ref": "#/$defs/copied"},
        "calls_form": {"enum": ["absent", "empty_list"]},
        "copy_of": {"type": "string", "pattern": "^m[0-9]+$"},
        "content_state": {"enum": ["post_defence"]},
        "placeholder_args": {"type": "object", "propertyNames": {"pattern": "^[0-9]+$"}},
        "system_prompt_variant": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "local_model_tag_count": {"type": "integer", "minimum": 1},
        "null_text_blocks": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "wire_parts": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "thinking_omitted": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "dropped_calls": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["index"], "properties": {"index": {"type": "integer", "minimum": 0}, "name": {}, "args_raw": {},
          "provider_call_id": {}}}}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "execution": {"$ref": "#/$defs/execution"},
    "actor": {"$ref": "#/$defs/actor"},
    "scope": {"$ref": "#/$defs/scope"},
    "message": {"$ref": "#/$defs/message"}
  }
}
