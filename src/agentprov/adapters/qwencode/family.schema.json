{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/agentprov/schema/adapters/qwencode/family-0.1.json",
  "title": "[family.qwencode] table of a qwencode source profile (D.4.1, D.24.9; closed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layout",
    "targets",
    "languages",
    "tools",
    "pairing",
    "semantics_profile"
  ],
  "properties": {
    "layout": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "pairing": {
      "type": "string",
      "pattern": "^qwencode\\.[a-z_]+@[1-9][0-9]*$"
    },
    "semantics_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "quirk": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "observed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^qwencode\\.[a-z][a-z0-9_]*$"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^qwencode\\.[a-z][a-z0-9_.]*@[1-9][0-9]*$"
            }
          },
          "note": {
            "type": "string"
          },
          "observed": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "S1",
          "S2",
          "S3"
        ]
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "python",
          "bash"
        ]
      }
    }
  }
}
