{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/agentprov/schema/adapters/agentops/family-0.1.json",
  "title": "[family.agentops] table of an agentops source profile (D.4.1, D.18.10; closed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["layout", "conditions", "in_scope", "tools", "pairing", "task_table", "semantics_profile"],
  "properties": {
    "layout": {"type": "string", "minLength": 1},
    "conditions": {"type": "array", "minItems": 1, "items": {"enum": ["clean", "noisy", "adversarial"]}},
    "in_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions", "domains"],
      "properties": {
        "conditions": {"type": "array", "items": {"enum": ["clean", "noisy", "adversarial"]}},
        "domains": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z_]*$"}}
      },
      "description": "the D-143 scope as data (documentation of the include and exclude globs, checked by a test)"
    },
    "tools": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "pairing": {"type": "string", "pattern": "^agentops\\.pair_[a-z_]+@[1-9][0-9]*$"},
    "task_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "rows"],
      "properties": {"file": {"type": "string"}, "rows": {"type": "integer", "minimum": 1}}
    },
    "semantics_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}}
    },
    "redact": {
      "type": "array",
      "description": "D-608: redaction rules over the tool messages' values (agentprov.adapters.agentops.redact; agentops.value_redacted@1)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "pattern", "replacement"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "scope": {"enum": ["tool_output"]},
          "pattern": {"type": "string", "minLength": 1},
          "replacement": {"type": "string", "minLength": 1},
          "leaf": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "quirk": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "observed"],
        "properties": {
          "id": {"type": "string", "pattern": "^agentops\\.[a-z][a-z0-9_]*$"},
          "rules": {"type": "array", "items": {"type": "string", "pattern": "^agentops\\.[a-z][a-z0-9_.]*@[1-9][0-9]*$"}},
          "note": {"type": "string"},
          "observed": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
        }
      }
    }
  }
}
